# MySQL connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=contract_risk_db

# Session signing secret (generate a unique random value of at least 32 characters)
AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters

# Qdrant (vector database)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=risk_clauses
